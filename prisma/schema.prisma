generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  ADMIN
}

enum SchemeStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum DonationStatus {
  PENDING
  PAID
  FAILED
}

enum MandateStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum Frequency {
  ONE_TIME
  MONTHLY
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(DONOR)
  donations    Donation[]
  createdAt    DateTime   @default(now())
}

model Scheme {
  id            String       @id @default(cuid())
  code          String       @unique
  need          String // PENSION | LIVELIHOOD | HEALTH | EDUCATION | HOUSING
  districts     String[] // empty = all districts
  titleHi       String
  titleEn       String
  summaryHi     String       @default("")
  benefitHi     String       @default("")
  eligibilityHi String       @default("")
  documentsHi   String[]
  howToApplyHi  String       @default("")
  summaryEn     String       @default("")
  benefitEn     String       @default("")
  eligibilityEn String       @default("")
  documentsEn   String[]
  howToApplyEn  String       @default("")
  sourceUrl     String
  noticeText    String
  rules         Json // see src/lib/eligibility.ts
  lastChecked   DateTime
  status        SchemeStatus @default(DRAFT)
  aiDrafted     Boolean      @default(false)
  reviewedBy    String?
  updatedAt     DateTime     @updatedAt
}

model HelpCentre {
  id       String @id @default(cuid())
  district String
  name     String
  phone    String
  address  String
}

model Campaign {
  id        String     @id @default(cuid())
  slug      String     @unique
  titleHi   String
  titleEn   String
  blurbHi   String
  blurbEn   String     @default("")
  goal      Int
  active    Boolean    @default(true)
  donations Donation[]
}

model Donation {
  id             String         @id @default(cuid())
  idempotencyKey String         @unique
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  campaignId     String
  campaign       Campaign       @relation(fields: [campaignId], references: [id])
  amount         Int // whole rupees
  donorName      String
  donorEmail     String
  donorPan       String
  donorAddress   String
  frequency      Frequency      @default(ONE_TIME)
  mandateStatus  MandateStatus?
  nextChargeAt   DateTime?
  parentId       String?
  parent         Donation?      @relation("Instalments", fields: [parentId], references: [id])
  instalments    Donation[]     @relation("Instalments")
  status         DonationStatus @default(PENDING)
  paymentRef     String?
  failureReason  String?
  receipt        Receipt?
  createdAt      DateTime       @default(now())

  @@index([campaignId, status])
  @@index([donorEmail])
}

model ReceiptCounter {
  fy     String @id // e.g. "2026-27"
  lastNo Int    @default(0)
}

model Receipt {
  id           String    @id @default(cuid())
  number       String    @unique
  fy           String
  seq          Int
  donationId   String    @unique
  donation     Donation  @relation(fields: [donationId], references: [id])
  issuedAt     DateTime  @default(now())
  cancelledAt  DateTime?
  cancelReason String?
  cancelledBy  String?

  @@unique([fy, seq])
}

model CallbackRequest {
  id          String    @id @default(cuid())
  phone       String
  district    String
  schemeCodes String[]
  note        String    @default("")
  handled     Boolean   @default(false)
  handledBy   String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// Mock email/SMS outbox: every message the system would send lands here.
model Outbox {
  id        String   @id @default(cuid())
  channel   String   @default("EMAIL")
  dedupeKey String?  @unique
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // lower-cased email
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model OtpCode {
  id           String   @id @default(cuid())
  email        String
  codeHash     String
  name         String
  passwordHash String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
}

// Anonymous finder usage counter (no answers stored), for the 50,000-uses goal.
model FinderUse {
  id        String   @id @default(cuid())
  via       String // QUESTIONS | AI_TEXT | VOICE
  matches   Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}
