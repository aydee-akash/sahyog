# Postgres connection string (Neon in production)
DATABASE_URL=
# 32+ character random string used to sign session cookies and receipt links
SESSION_SECRET=
# Optional: enables AI Hindi summary drafts in the admin CMS
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-5-5)
ANTHROPIC_MODEL=
# Public base URL, used in share links and receipt emails (e.g. https://sahyog.example.org)
APP_URL=
# Optional: HMAC secret for /api/payments/webhook
PAYMENT_WEBHOOK_SECRET=
# Optional: only on networks whose DNS cannot resolve the database host, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=
# Optional: direct (unpooled) Postgres URL for migrations (Neon provides it)
DATABASE_URL_UNPOOLED=
# Tests only: a separate, disposable Postgres database
TEST_DATABASE_URL=
